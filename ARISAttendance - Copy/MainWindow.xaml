<Window x:Class="ARISAttendance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARIS Attendance :: Auto-Correct Dashboard" 
        Height="750" Width="1300" WindowStartupLocation="CenterScreen" Background="#F4F6F9">

    <Grid>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Top Main Toolbar -->
            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="BtnImportDdd" Content="💾 1. Import (.ddd)" Width="140" Height="35" Margin="0,0,10,10" Background="#2980B9" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnImportDdd_Click"/>
                <Button x:Name="BtnImportDbf" Content="📂 2. Import (.dbf)" Width="140" Height="35" Margin="0,0,10,10" Background="#008E4A" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnImportDbf_Click"/>

                <Button x:Name="BtnEditSelected" Content="✏️ Edit Selected" Width="130" Height="35" Margin="0,0,10,10" Background="#F1C40F" Foreground="Black" FontWeight="Bold" Cursor="Hand" Click="BtnEditSelected_Click"/>
                <Button x:Name="BtnAutoCorrect" Content="✨ Auto-Fill OUTs" Width="140" Height="35" Margin="0,0,10,10" Background="#27AE60" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnAutoCorrect_Click"/>
                <Button x:Name="BtnClearData" Content="🗑️ Clear Punches" Width="130" Height="35" Margin="0,0,10,10" Background="#E74C3C" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnClearData_Click"/>

                <Button x:Name="BtnExportDdd" Content="📤 Export Final .ddd" Width="150" Height="35" Margin="0,0,10,10" Background="#1A5276" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnExportDdd_Click"/>

                <Button x:Name="BtnRefreshGrid" Content="🔄 Refresh" Width="100" Height="35" Margin="0,0,10,10" Background="#ECF0F1" FontWeight="Bold" Cursor="Hand" Click="BtnRefreshGrid_Click"/>
                <Button x:Name="BtnSettings" Content="⚙️ Settings" Width="100" Height="35" Margin="0,0,20,10" Background="#7F8C8D" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnSettings_Click"/>

                <CheckBox x:Name="ChkShowAll" Content="Show ALL Records" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Checked="ChkShowAll_Changed" Unchecked="ChkShowAll_Changed"/>
            </WrapPanel>

            <!-- ROW 1: Search Bar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="🔍 Search:" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtSearchEmp" Width="200" Height="28" VerticalContentAlignment="Center" KeyDown="TxtSearchEmp_KeyDown"/>
                <Button x:Name="BtnSearch" Content="Find" Width="60" Height="28" Margin="10,0,5,0" Background="#3498DB" Foreground="White" FontWeight="Bold" Click="BtnSearch_Click"/>
                <Button x:Name="BtnClearSearch" Content="Clear" Width="60" Height="28" Background="#BDC3C7" FontWeight="Bold" Click="BtnClearSearch_Click"/>
            </StackPanel>

            <!-- ROW 2: DataGrid -->
            <GroupBox x:Name="GridGroupBox" Grid.Row="2" Header="⚠️ Exceptions (Missing Punches)" FontWeight="Bold" FontSize="14">
                <DataGrid x:Name="ExceptionGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="Horizontal" SelectionMode="Single" FontWeight="Normal" FontSize="12" Margin="5">
                    <DataGrid.Columns>
                        <!-- 🔥 NEW: Checkbox Select All Column -->
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="chkSelectAll" Click="chkSelectAll_Click" ToolTip="Select / Deselect All"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Emp Code" Binding="{Binding EmpCode}" Width="80"/>
                        <DataGridTextColumn Header="Employee Name" Binding="{Binding FullName}" Width="200"/>
                        <DataGridTextColumn Header="Cat" Binding="{Binding Category}" Width="50"/>
                        <DataGridTextColumn Header="Shift" Binding="{Binding Shift}" Width="50"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding WorkDate, StringFormat=dd-MM-yyyy}" Width="90"/>

                        <DataGridTextColumn Header="In" Binding="{Binding PunchIn, StringFormat=HH:mm}" Width="60"/>
                        <DataGridTextColumn Header="L-Out" Binding="{Binding LunchOut, StringFormat=HH:mm}" Width="60"/>
                        <DataGridTextColumn Header="L-In" Binding="{Binding LunchIn, StringFormat=HH:mm}" Width="60"/>
                        <DataGridTextColumn Header="Out" Binding="{Binding PunchOut, StringFormat=HH:mm}" Width="60"/>

                        <DataGridTextColumn Header="P5" Binding="{Binding Punch5, StringFormat=HH:mm}" Width="50"/>
                        <DataGridTextColumn Header="P6" Binding="{Binding Punch6, StringFormat=HH:mm}" Width="50"/>
                        <DataGridTextColumn Header="P7" Binding="{Binding Punch7, StringFormat=HH:mm}" Width="50"/>
                        <DataGridTextColumn Header="P8" Binding="{Binding Punch8, StringFormat=HH:mm}" Width="50"/>

                        <DataGridCheckBoxColumn Header="Exception?" Binding="{Binding IsException}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- ========================================== -->
        <!-- OVERLAY 1: SINGLE EDIT PANEL (Kept for safe compiling) -->
        <!-- ========================================== -->
        <Border x:Name="EditPanelOverlay" Background="#88000000" Visibility="Collapsed">
            <Border Background="White" Width="300" Height="420" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtEditTitle" Text="Editing: " FontWeight="Bold" FontSize="16" Margin="0,0,0,15" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="In Time:" Grid.Row="0" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="TxtEditIn" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="Lunch Out:" Grid.Row="1" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="TxtEditLOut" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="Lunch In:" Grid.Row="2" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="TxtEditLIn" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="Out Time:" Grid.Row="3" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="TxtEditOut" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="Punch 5:" Grid.Row="4" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="TxtEditP5" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="Punch 6:" Grid.Row="5" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="TxtEditP6" Grid.Row="5" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="Punch 7:" Grid.Row="6" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="TxtEditP7" Grid.Row="6" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="Punch 8:" Grid.Row="7" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="TxtEditP8" Grid.Row="7" Grid.Column="1" Margin="0,5"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Save" Width="80" Height="30" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Click="BtnSaveEdit_Click"/>
                        <Button Content="Cancel" Width="80" Height="30" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnCancelEdit_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ========================================== -->
        <!-- OVERLAY 2: SETTINGS PANEL                  -->
        <!-- ========================================== -->
        <Border x:Name="SettingsPanelOverlay" Background="#88000000" Visibility="Collapsed">
            <Border Background="White" Width="500" Height="500" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="⚙️ Special Rules &amp; Settings" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Auto-Fill Rules -->
                            <GroupBox Header="Always Auto-Fill Employees" FontWeight="Bold" Margin="0,0,0,15" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBox x:Name="TxtAutoFillEmp" Width="100" Margin="0,0,10,0" ToolTip="Enter 4-digit Emp Code"/>
                                        <Button Content="Add Rule" Width="80" Click="BtnAddAutoFill_Click"/>
                                    </StackPanel>
                                    <ListBox x:Name="ListAutoFill" Height="80" Margin="0,0,0,5"/>
                                    <Button Content="Remove Selected" Width="120" HorizontalAlignment="Left" Click="BtnRemoveAutoFill_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Early Lunch Rules -->
                            <GroupBox Header="Shift Early Lunch Employees" FontWeight="Bold" Margin="0,0,0,15" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBox x:Name="TxtEarlyLunchEmp" Width="100" Margin="0,0,10,0" ToolTip="Enter 4-digit Emp Code"/>
                                        <Button Content="Add Rule" Width="80" Click="BtnAddEarlyLunch_Click"/>
                                    </StackPanel>
                                    <ListBox x:Name="ListEarlyLunch" Height="80" Margin="0,0,0,5"/>
                                    <Button Content="Remove Selected" Width="120" HorizontalAlignment="Left" Click="BtnRemoveEarlyLunch_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Date Swap Tool -->
                            <GroupBox Header="Danger Zone: Date Swapper" FontWeight="Bold" BorderBrush="#E74C3C" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Move all punches from one date to another to bypass legacy week-off overtime rules." TextWrapping="Wrap" FontWeight="Normal" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Normal"/>
                                        <TextBox x:Name="TxtSwapFrom" Width="100" Margin="0,0,15,0" ToolTip="DD-MM-YYYY"/>
                                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Normal"/>
                                        <TextBox x:Name="TxtSwapTo" Width="100" Margin="0,0,15,0" ToolTip="DD-MM-YYYY"/>
                                        <Button Content="Swap" Width="60" Background="#E74C3C" Foreground="White" Click="BtnApplyDateSwap_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Close Settings" Height="35" Width="120" HorizontalAlignment="Right" Background="#34495E" Foreground="White" FontWeight="Bold" Click="BtnCloseSettings_Click" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Border>

    </Grid>
</Window>